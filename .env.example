# ==========================================================================
# О дивный новый VPN — шаблон переменных окружения
#
# Скопируйте файл: `cp .env.example .env`  и замените значения на свои.
# Все переменные читаются pydantic-settings'ом с префиксом NEOVPN_.
# В коде ничего править не нужно.
# ==========================================================================

# === Telegram =============================================================
# Получить у @BotFather: /newbot → скопировать строку вида 123456789:ABC...
NEOVPN_BOT_TOKEN=123456:TEST
# Ваш Telegram ID (узнать у @userinfobot). Несколько админов — через запятую.
NEOVPN_BOT_ADMIN_IDS=12345678
# Имя бота из BotFather без «@».
NEOVPN_BOT_USERNAME=NeoVPN_bot

# === Публичные URL (для deep-link'ов и Callback-URL'ов) ==================
NEOVPN_PUBLIC_WEB_URL=http://localhost:3000
NEOVPN_PUBLIC_API_URL=http://localhost:8000

# === Хранилища ============================================================
# Для локального docker compose — оставьте `postgres` и `redis` как hostname.
NEOVPN_DATABASE_URL=postgresql+asyncpg://neovpn:neovpn@localhost:5432/neovpn
NEOVPN_REDIS_URL=redis://localhost:6379/0

# === Авторизация сайта ====================================================
# Любая случайная строка ≥ 32 байт. Пример:  openssl rand -hex 32
NEOVPN_JWT_SECRET=change-me-please-32-bytes-minimum-secret

# === Панель Marzban =======================================================
# Если Marzban ещё не развернут — оставьте значения и заполните позже.
NEOVPN_MARZBAN_URL=https://marzban.example.com
NEOVPN_MARZBAN_USERNAME=admin
NEOVPN_MARZBAN_PASSWORD=admin

# === Платежи ==============================================================
# Включить/выключить Telegram Stars (true/false).
NEOVPN_STARS_ENABLED=true

# CryptoBot: https://t.me/CryptoBot → Crypto Pay → Create App → API Token.
# Webhook-секрет — там же, в настройках webhooks.
# Оставьте пустыми, чтобы отключить крипто-кнопки в боте.
NEOVPN_CRYPTOBOT_TOKEN=
NEOVPN_CRYPTOBOT_WEBHOOK_SECRET=
